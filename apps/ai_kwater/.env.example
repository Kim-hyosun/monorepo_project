# ai_kwater 환경 변수 예시
# 로컬: 이 파일을 .env.local 로 복사 후 값을 채워 사용
# 배포(Vercel): Dashboard → Settings → Environment Variables 에 동일 키 등록

# 실 API 베이스 URL (axios instance baseURL 로 사용)
NEXT_PUBLIC_API_BASE_URL=https://api-dev.example.com

# MSW 활성화 — dev 환경(local)에서만 'true' 권장. prod build 에서는 'false' 또는 미설정.
# providers.tsx 에서 'true' 일 때만 worker.start() 호출
NEXT_PUBLIC_USE_MSW=false
